---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { site } from '../data/site';

// Replace the placeholder copy below with your real Privacy Policy. The structure
// follows a standard outline (data collected, how it's used, third parties, your
// rights, contact). Keep `lastUpdated` current — search engines and some users
// look at it. Consult a lawyer in your jurisdiction for production use.
const lastUpdated = 'April 26, 2026';
---

<BaseLayout
  title="Privacy Policy"
  description="How we collect, use, and protect your data."
>
  <PageHero
    eyebrow="Legal"
    title="Privacy <em>Policy.</em>"
    description={`Last updated: ${lastUpdated}`}
  />

  <section class="pb-[120px]">
    <div class="wrap">
      <article class="legal-prose mx-auto max-w-[720px] text-[17px] leading-[1.7] text-ink-2">
        <p class="lead">
          This is placeholder copy. Replace every section with policy language that reflects
          how <strong>{site.name}</strong> actually handles user data. Consult a lawyer
          in your jurisdiction before publishing.
        </p>

        <h2>1. Information we collect</h2>
        <p>
          Describe the categories of data you collect — for example, contact form
          submissions (name, email, message), analytics events, cookies, and any
          third-party integrations.
        </p>

        <h2>2. How we use your information</h2>
        <p>
          Explain the purposes: responding to inquiries, improving the site,
          sending newsletters (only with consent), and fulfilling legal obligations.
        </p>

        <h2>3. Sharing with third parties</h2>
        <p>
          List every processor that touches user data — analytics provider, email
          service, hosting, form backend. Link to each provider's own privacy policy.
        </p>

        <h2>4. Cookies</h2>
        <p>
          Describe what cookies you set, why, and how a visitor can opt out. If you
          operate in the EU/UK, you'll need a consent banner — this template does
          not include one.
        </p>

        <h2>5. Your rights</h2>
        <p>
          Summarize the rights granted by the regulations that apply to you (GDPR,
          CCPA, LGPD, etc.) — access, correction, deletion, portability, objection.
        </p>

        <h2>6. Data retention</h2>
        <p>
          State how long you keep different categories of data and what happens
          when the retention period ends.
        </p>

        <h2>7. Security</h2>
        <p>
          Describe technical and organizational measures: encryption in transit,
          access control, training, incident response.
        </p>

        <h2>8. Contact</h2>
        <p>
          Questions about this policy? Email us at <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  /* Article typography — kept local because legal pages are the only place we
     render long-form prose without MDX/content-collection styling. */
  .legal-prose .lead {
    font-size: 19px;
    color: var(--color-ink);
    margin-bottom: 36px;
  }
  .legal-prose h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 48px 0 16px;
  }
  .legal-prose p { margin: 0 0 18px; }
  .legal-prose a {
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
    transition: border-color .15s ease;
  }
  .legal-prose a:hover { border-color: var(--color-ink); }
  .legal-prose strong { color: var(--color-ink); font-weight: 600; }
</style>
