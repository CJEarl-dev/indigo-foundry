---
import BaseLayout from '../layouts/BaseLayout.astro';
import Story from '../components/about/Story.astro';
import Values from '../components/about/Values.astro';
import CTA from '../components/home/CTA.astro';
---

<BaseLayout
  title="About"
  description="Learn our story and the values that shape every project we take on."
>
  <section class="relative overflow-hidden pt-[100px] pb-[60px] text-center">
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(55% 60% at 50% 0%, #4F46E528 0%, transparent 70%);"
    ></div>

    <div class="wrap">
      <p class="hero-eyebrow">// About the studio</p>
      <h1 class="about-head animate-fade-up mx-auto mt-5 max-w-[1000px] font-serif">
        Serious about the craft. <em>Focused on your project.</em>
      </h1>
      <p class="mx-auto mt-7 max-w-[640px] text-[19px] text-ink-2">
      When you work with Indigo Foundry, you work with me — start to finish, no handoffs, no surprises.
      </p>
    </div>
  </section>

  <Story />
  <Values />

  <CTA
    eyebrow="Want to work with us?"
    titleHtml={'Let\u2019s find out if we\u2019re <span class="mark-hl">a good fit.</span>'}
    description="Tell us about your project and we'll get back within one business day."
    primaryLabel="Start a conversation"
    primaryHref="/contact"
    secondaryLabel=""
    secondaryHref=""
    showAnnotation={false}
  />
</BaseLayout>

<style>
  .about-head {
    font-weight: 400;
    font-size: clamp(48px, 7.5vw, 112px);
    line-height: .95;
    letter-spacing: -0.02em;
  }
  .about-head :global(em) { font-style: italic; color: #a85c00;}
</style>
