---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesGrid from '../components/services/ServicesGrid.astro';
import Process from '../components/services/Process.astro';
import CTA from '../components/home/CTA.astro';
---

<BaseLayout
  title="Services"
  description="Web development, accessibility audits, maintenance, and content services for organizations that refuse to cut corners."
>
  <section class="relative overflow-hidden pt-[100px] pb-20 text-center">
    <!-- Radial ambient glow -->
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(60% 60% at 50% 0%, #4F46E528 0%, transparent 70%);"
    ></div>

    <div class="wrap">
    <p class="hero-eyebrow">// Services</p>
    <h1 class="page-hero-head animate-fade-up mt-5 font-serif">Our <em>services.</em></h1>
      <p class="mx-auto mt-7 max-w-[640px] text-[19px] text-ink-2">
        Custom websites, accessibility audits, and ongoing support — built with intention, scoped to what you actually need.
      </p>
    </div>
  </section>

  <!-- Annotation: locked above the 2nd services card via a matching 2-col grid -->


  <ServicesGrid />
  <Process />

  <CTA
    eyebrow="Have a project in mind?"
    titleHtml={'Let\u2019s <span class="mark-hl rot-r">scope it</span> together.'}
    description="Tell us about your goals and timeline — we'll reply with a rough plan and a realistic estimate."
    primaryLabel="Get in touch"
    primaryHref="/contact"
    secondaryLabel=""
    secondaryHref=""
    showAnnotation={false}
  />
</BaseLayout>

<style>
  .page-hero-head {
    font-weight: 400;
    font-size: clamp(56px, 9vw, 140px);
    line-height: .95;
    letter-spacing: -0.02em;
  }
  .page-hero-head :global(em) { font-style: italic; color: #a85c00;}
</style>
