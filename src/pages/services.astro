---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesGrid from '../components/services/ServicesGrid.astro';
import Process from '../components/services/Process.astro';
import CTA from '../components/home/CTA.astro';
---

<BaseLayout
  title="Services"
  description="End-to-end digital services: web design, web development, SEO, branding, content strategy, and UI/UX."
>
  <section class="relative overflow-hidden pt-[100px] pb-20 text-center">
    <!-- Radial ambient glow -->
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(60% 60% at 50% 0%, #D8F65128 0%, transparent 70%);"
    ></div>

    <div class="wrap">
      <span class="pill-tag">Services</span>
      <h1 class="page-hero-head animate-fade-up mt-5 font-serif">Our <em>services.</em></h1>
      <p class="mx-auto mt-7 max-w-[640px] text-[19px] text-ink-2">
        Strategy, design, and engineering for ambitious digital products.
        Pick a single service or hire us end-to-end.
      </p>
    </div>
  </section>

  <!-- Annotation: locked above the 2nd services card via a matching 2-col grid -->
  <div class="hidden lg:block" aria-hidden="true">
    <div class="mx-auto max-w-[1280px] px-8">
      <div class="grid grid-cols-2 gap-5">
        <div></div>
        <div class="flex justify-center">
          <div class="flex">
            <svg xmlns="http://www.w3.org/2000/svg" width="70" height="70" viewBox="0 0 70 70" fill="none">
              <path d="M63.9926 6.77063C64.4182 6.65203 64.6671 6.21085 64.5485 5.78524C64.4299 5.35963 63.9887 5.11076 63.5631 5.22937L63.7778 6L63.9926 6.77063ZM18.0009 60.4434C18.2458 60.8112 18.7424 60.9108 19.1102 60.6659L25.1028 56.6749C25.4706 56.4299 25.5701 55.9333 25.3252 55.5656C25.0803 55.1978 24.5837 55.0982 24.2159 55.3432L18.8891 58.8907L15.3416 53.5639C15.0967 53.1962 14.6 53.0966 14.2323 53.3415C13.8645 53.5864 13.765 54.083 14.0099 54.4508L18.0009 60.4434ZM63.7778 6L63.5631 5.22937C53.4957 8.03492 43.3429 15.4021 35.0898 25.1712C26.8307 34.9473 20.4185 47.1929 17.8823 59.8427L18.6667 60L19.4511 60.1573C21.9272 47.8071 28.2026 35.8027 36.312 26.2038C44.4272 16.5979 54.3239 9.46508 63.9926 6.77063L63.7778 6Z" fill="#141210"/>
            </svg>
            <span class="note">pick one<br/>or pick them all</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ServicesGrid />
  <Process />

  <CTA
    eyebrow="Have a project in mind?"
    titleHtml={'Let\u2019s <span class="mark-hl rot-r">scope it</span> together.'}
    description="Tell us about your goals and timeline — we'll reply with a rough plan and a realistic estimate."
    primaryLabel="Get in touch"
    primaryHref="/contact"
    secondaryLabel=""
    secondaryHref=""
    showAnnotation={false}
  />
</BaseLayout>

<style>
  .page-hero-head {
    font-weight: 400;
    font-size: clamp(56px, 9vw, 140px);
    line-height: .95;
    letter-spacing: -0.02em;
  }
  .page-hero-head :global(em) { font-style: italic; color: var(--color-ink-2); }
</style>
