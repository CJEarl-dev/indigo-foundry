---
// About metrics — on the muted warm bg-2 (gray) instead of dark ink, per user feedback
import { stats } from '../../data/about';
---

<section class="relative overflow-hidden bg-bg-2 py-20 text-ink">
  <div
    class="pointer-events-none absolute inset-0 opacity-50"
    style="background-image: radial-gradient(#14121015 1px, transparent 1px); background-size: 28px 28px;"
    aria-hidden="true"
  ></div>

  <div class="wrap relative">
    <div class="grid grid-cols-2 gap-6 lg:grid-cols-4">
      {stats.map((stat, i) => (
        <div class="py-3">
          <div class="text-[72px] leading-none tracking-[-0.02em] text-ink">
            {i === 0 ? <span class="mark-hl">{stat.value}</span> : stat.value}
          </div>
          <div class="mt-3.5 font-mono text-[11px] tracking-[.16em] text-muted uppercase">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
