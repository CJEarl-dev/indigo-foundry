---
// Values — keeps the striped dashed detail from the reference design
import { values } from '../../data/about';
import type { ValueIcon } from '../../data/about';

const iconMap: Record<ValueIcon, string> = {
  sparkles: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>',
  eye: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>',
  handshake: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>',
  'bar-chart': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>',
};
---

<section class="relative bg-bg-2 py-[120px] max-md:py-20">
  <div class="wrap">
    <div class="mb-14 max-w-[700px]">
      <span class="eyebrow">Values</span>
      <h2 class="values-head mt-4 font-serif">
        What we believe <em>about the work.</em>
      </h2>
    </div>

    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {values.map((value) => (
        <li class="relative overflow-hidden rounded-[18px] border border-dashed border-line-strong bg-bg pt-8 pr-7 pb-7 pl-7">
          <!-- Striped dashed corner — complex repeating gradient, stays inline -->
          <div
            class="pointer-events-none absolute -top-5 -right-5 h-20 w-20 opacity-60"
            style="background: repeating-linear-gradient(45deg, #3D3580 0 6px, transparent 6px 12px);"
            aria-hidden="true"
          ></div>

          <div
            class="mb-5 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#1A1830] text-white"
            aria-hidden="true"
            set:html={iconMap[value.icon] ?? iconMap.sparkles}
          />

          <h3 class="text-[24px] font-medium tracking-[-0.01em] text-ink">
            {value.title}
          </h3>
          <p class="mt-2.5 text-sm leading-[1.6] text-ink-2">{value.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .values-head {
    font-weight: 400;
    font-size: clamp(32px, 3.5vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .values-head :global(em) { font-style: italic; color: #a85c00;}
</style>