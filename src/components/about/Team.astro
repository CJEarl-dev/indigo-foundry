---
// Team grid — member names in SANS-SERIF per feedback (was serif in reference)
import { team } from '../../data/about';
---

<section class="py-[120px] max-md:py-20">
  <div class="wrap">
    <div class="mb-14 max-w-[700px]">
      <span class="eyebrow">The team</span>
      <h2 class="team-head mt-4 font-serif">
        A small group of people <em>you&rsquo;ll actually talk to.</em>
      </h2>
    </div>

    <ul class="grid grid-cols-1 gap-9 sm:grid-cols-2 lg:grid-cols-4">
      {team.map((member) => (
        <li>
          {member.image ? (
            <img
              src={member.image}
              alt={`Portrait of ${member.name}`}
              loading="lazy"
              decoding="async"
              class="mb-5 aspect-square w-full rounded-[20px] object-cover"
            />
          ) : (
            <div class="ph ph-light mb-5 aspect-square rounded-[20px]" aria-hidden="true">
              <div>
                <div class="ph-label">{member.role}</div>
                <div class="ph-title font-sans">{member.name.split(' ')[0]}</div>
              </div>
            </div>
          )}
          <h3 class="font-sans text-[18px] font-medium tracking-[-0.005em] text-ink">
            {member.name}
          </h3>
          <p class="mt-1 font-mono text-[11px] tracking-[.14em] text-muted uppercase">
            {member.role}
          </p>
          <p class="mt-3.5 text-sm leading-[1.55] text-ink-2">{member.bio}</p>
          <ul class="mt-4 flex flex-wrap gap-3.5">
            {member.social.x && (
              <li><a href={member.social.x} rel="noopener" class="text-[13px] text-ink border-b border-line transition-colors hover:border-ink">X ↗</a></li>
            )}
            {member.social.linkedin && (
              <li><a href={member.social.linkedin} rel="noopener" class="text-[13px] text-ink border-b border-line transition-colors hover:border-ink">LinkedIn ↗</a></li>
            )}
            {member.social.github && (
              <li><a href={member.social.github} rel="noopener" class="text-[13px] text-ink border-b border-line transition-colors hover:border-ink">GitHub ↗</a></li>
            )}
            {member.social.dribbble && (
              <li><a href={member.social.dribbble} rel="noopener" class="text-[13px] text-ink border-b border-line transition-colors hover:border-ink">Dribbble ↗</a></li>
            )}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .team-head {
    font-weight: 400;
    font-size: clamp(32px, 3.5vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .team-head :global(em) { font-style: italic; color: #a85c00;}
</style>
