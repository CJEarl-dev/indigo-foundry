---
import { nav } from '../data/site';
import logo from '../images/indigo-foundry-logo-black-transparent.png';
const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<nav
  class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md"
  aria-label="Primary"
>
  <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-8 px-5 py-2 lg:grid lg:grid-cols-[auto_1fr_auto] lg:gap-4 lg:px-8 xl:gap-8">
    <a class="logo flex items-center" href="/" aria-label="Indigo Foundry — home">
      <img src={logo.src} alt="Indigo Foundry" style="height: 100px; width: auto; min-width: 160px;" />
    </a>

    <div class="hidden justify-center gap-0.5 text-sm text-ink-2 lg:flex lg:gap-1">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-full px-2.5 py-2 transition-[background,color] duration-200 hover:bg-bg-2 hover:text-ink lg:px-3.5',
            isActive(item.href) && 'bg-bg-2 font-medium text-ink',
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>

    <a
      href="/contact"
      class="hidden items-center gap-2 whitespace-nowrap rounded-full border border-ink bg-ink px-[18px] py-[9px] text-[13px] font-medium text-bg transition-[background,color,border-color] duration-200 hover:border-accent hover:bg-accent hover:text-accent-ink lg:inline-flex"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
      Get in touch
    </a>

    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-line-strong hover:bg-bg-2 lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-menu-button
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</nav>

<!--
  Mobile menu lives OUTSIDE <nav> on purpose:
  the navbar uses `backdrop-blur-md` (backdrop-filter), which creates a containing
  block for `position: fixed` descendants. Placed here, the overlay is positioned
  relative to the viewport as expected.
-->
<div
  id="mobile-menu"
  class="mobile-menu fixed inset-0 z-[60] flex-col bg-bg lg:!hidden"
  data-mobile-menu
  aria-hidden="true"
>
    <!-- Top bar: logo + close -->
    <div class="flex items-center justify-between px-5 py-[18px]">
      <a class="logo flex items-center" href="/" aria-label="Indigo Foundry — home">
        <img src={logo.src} alt="Indigo Foundry" style="height: 100px; width: auto;" />
      </a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-ink text-bg"
        aria-label="Close menu"
        data-mobile-menu-button
      >
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <!-- Nav items (numbered) -->
    <ul class="flex-1 overflow-y-auto px-5">
      {nav.map((item, i) => (
        <li class="border-b border-line last:border-b-0">
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'flex items-center gap-5 py-5 transition-colors',
              isActive(item.href) ? 'text-ink' : 'text-ink',
            ]}
          >
            <span class="font-mono text-[11px] tracking-[.18em] text-muted tabular-nums">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="flex-1 text-[20px] font-medium tracking-[-0.01em]">
              {item.label}
            </span>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="text-muted" aria-hidden="true">
              <path d="M5 13L13 5M7 5h6v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <!-- Bottom CTA card -->
    <div class="px-5 pb-6 pt-3">
      <a
        href="/contact"
        class="flex items-center justify-between gap-4 rounded-2xl bg-ink px-5 py-4 text-bg"
      >
        <div>
          <div class="font-mono text-[10px] tracking-[.18em] uppercase text-bg/55">
            <span class="mr-1.5 inline-block h-1.5 w-1.5 translate-y-[-2px] rounded-full bg-accent align-middle"></span>
            Ready to start?
          </div>
          <div class="mt-1 text-[22px] font-medium tracking-[-0.005em]">
            Get in touch
          </div>
        </div>
        <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-accent text-accent-ink">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 12L12 4M6 4h6v6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    </div>
</div>

<style>
  /* Mobile menu — toggled via .is-open class. Custom CSS to beat Tailwind's `flex-col` ordering. */
  .mobile-menu { display: none; }
  .mobile-menu.is-open { display: flex; }
  @media (min-width: 1024px) {
    .mobile-menu,
    .mobile-menu.is-open { display: none !important; }
  }
</style>

<script>
  // Delegated handler — works across View Transitions
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const button = target.closest<HTMLButtonElement>('[data-mobile-menu-button]');
    if (!button) return;

    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    if (!menu) return;

    const willOpen = !menu.classList.contains('is-open');
    menu.classList.toggle('is-open', willOpen);
    menu.setAttribute('aria-hidden', String(!willOpen));
    document.body.classList.toggle('overflow-hidden', willOpen);

    // Sync aria-expanded on every menu button on the page
    document.querySelectorAll<HTMLButtonElement>('[data-mobile-menu-button]').forEach((btn) => {
      btn.setAttribute('aria-expanded', String(willOpen));
    });
  });

  // Close menu after navigating to another page
  document.addEventListener('astro:after-swap', () => {
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    if (menu && menu.classList.contains('is-open')) {
      menu.classList.remove('is-open');
      menu.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');
      document.querySelectorAll<HTMLButtonElement>('[data-mobile-menu-button]').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
      });
    }
  });
</script>