---
import { site, footerNav } from '../data/site';
import logo from '../images/indigo-foundry-logo-white-transparent.svg';
const year = new Date().getFullYear();
---

<footer class="footer bg-ink text-[#C9C4BA] pt-24 pb-10 border-t border-ink">
  <div class="wrap">
    <div class="grid grid-cols-2 gap-10 pb-[72px] lg:grid-cols-[2fr_1fr_1fr_1fr]">
      <div class="col-span-2 lg:col-span-1">
        <a class="logo flex items-center" href="/" aria-label={`${site.name} — home`}>
          <img src={logo.src} alt="Indigo Foundry" style="height: 70px; width: auto;" />
        </a>
        <p class="mt-4 max-w-[320px] text-sm text-ink-soft">{site.description}</p>
      </div>

      <div>
        <h3 class="mb-4 font-mono text-[11px] font-normal tracking-[.18em] text-ink-soft uppercase">Company</h3>
        <ul class="flex flex-col gap-2.5 text-sm">
          {footerNav.company.map((item) => (
            <li><a href={item.href} class="transition-colors hover:text-accent">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-mono text-[11px] font-normal tracking-[.18em] text-ink-soft uppercase">Resources</h3>
        <ul class="flex flex-col gap-2.5 text-sm">
          {footerNav.resources.map((item) => (
            <li><a href={item.href} class="transition-colors hover:text-accent">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-mono text-[11px] font-normal tracking-[.18em] text-ink-soft uppercase">Legal</h3>
        <ul class="flex flex-col gap-2.5 text-sm">
          {footerNav.legal.map((item) => (
            <li><a href={item.href} class="transition-colors hover:text-accent">{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-7 text-[13px] text-ink-soft">
      <div>© {year} {site.name}. All rights reserved.</div>
      <div class="flex flex-wrap gap-[22px]">
        <a href={site.social.x} rel="noopener" class="transition-colors hover:text-accent">X</a>
        <a href={site.social.linkedin} rel="noopener" class="transition-colors hover:text-accent">LinkedIn</a>
        <a href={site.social.instagram} rel="noopener" class="transition-colors hover:text-accent">Instagram</a>
        <a href={site.social.github} rel="noopener" class="transition-colors hover:text-accent">GitHub</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Logo color overrides when nested in the dark footer */
  .footer .logo .mark { color: var(--color-bg); }
  .footer .logo .tag { color: var(--color-ink-soft); }
</style>