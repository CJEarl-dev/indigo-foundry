---
// Services preview — 4-up grid with lime hover + "related work" reveal on hover (lambdakit-style)
import { services } from '../../data/services';

// Shape each featured service with a number, practice label, and related work tag
const featured = services.slice(0, 4).map((s, i) => ({
  ...s,
  num: String(i + 1).padStart(2, '0'),
  label: ['Design', 'Engineering', 'Growth', 'Identity'][i] ?? 'Practice',
  // Split the last word into an italic span for editorial feel
  splitTitle: (() => {
    const parts = s.title.split(' ');
    const last = parts.pop()!;
    return { head: parts.join(' '), em: last };
  })(),
  related: ['Northwind', 'Lumen', 'Helio', 'Mercato'][i] ?? '—',
}));
---

<section class="pt-[120px] pb-10">
  <div class="wrap">
    <div class="mb-14 grid grid-cols-1 items-end gap-8 md:grid-cols-[1fr_auto]">
      <div class="flex flex-col gap-4">
        <span class="eyebrow">What we do</span>
        <h2 class="services-head font-serif">Services built<br/>around <em>outcomes.</em></h2>
      </div>
      <a class="btn btn-ghost justify-self-start md:justify-self-end" href="/services">All services →</a>
    </div>

    <div class="grid grid-cols-1 overflow-hidden rounded-3xl border-t border-l border-line bg-card sm:grid-cols-2 lg:grid-cols-4">
      {featured.map((service) => (
        <a
          class="service-card group relative flex min-h-[280px] flex-col overflow-hidden border-r border-b border-line bg-card px-7 pt-9 pb-7 transition-[background,transform] duration-300 hover:-translate-y-0.5 hover:bg-[#1a1830]"
          href={`/services#${service.slug}`}
        >
          <div class="flex items-center justify-between font-mono text-[11px] tracking-[.18em] text-muted uppercase transition-colors duration-300 group-hover:text-white">
            <span>{service.num} / {service.label}</span>
            <span
              class="inline-flex h-[30px] w-[30px] items-center justify-center rounded-full border border-line-strong transition-all duration-300 rotate-45 group-hover:rotate-0 group-hover:border-ink group-hover:bg-ink group-hover:text-accent"
              aria-hidden="true"
            >
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                <path d="M2.5 7.5 L7.5 2.5 M3.5 2.5 H7.5 V6.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </span>
          </div>

          <div class="mt-auto pt-20 transition-transform duration-300 group-hover:-translate-y-2">
            <h3 class="text-[32px] leading-none tracking-[-0.015em] transition-colors group-hover:text-white">
              {service.splitTitle.head}
              <em class="italic text-ink-2 transition-colors group-hover:text-white group-hover:opacity-70">{service.splitTitle.em}</em>
            </h3>
            <p class="mt-3.5 text-[13.5px] leading-[1.5] text-ink-2 transition-colors group-hover:text-white">
              {service.short}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Fluid heading via clamp() + italic styling for nested <em> */
  .services-head {
    font-weight: 400;
    font-size: clamp(44px, 5.6vw, 84px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .services-head :global(em) { font-style: italic; color: #a85c00;}
</style>