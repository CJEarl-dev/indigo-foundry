---
// About preview — copy + 2x2 stats. First stat gets the mark-hl treatment on "150+".
import { stats } from '../../data/about';
---

<section class="py-[120px] max-md:py-20">
  <div class="wrap">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
      <div>
        <span class="eyebrow">About us</span>
        <h2 class="about-heading mt-4 font-serif">
          A small team with a <em>big appetite</em> for good work.
        </h2>
        <p class="mt-6 max-w-[620px] text-[19px] leading-[1.5] text-ink-2">
          We're a fully-remote studio of 12 designers, engineers and strategists.
          For eight years we've been helping ambitious companies ship digital products
          their customers enjoy.
        </p>
        <a class="btn btn-primary mt-8" href="/about">
          More about us
          <svg class="arrow" width="14" height="14" viewBox="0 0 14 14">
            <path d="M3 11 L11 3 M5 3 H11 V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-2 gap-6">
        {stats.map((stat) => (
          <div class="rounded-2xl border border-line bg-card p-7">
            <div class="text-[56px] leading-none tracking-[-0.02em]">
              {stat.value}
            </div>
            <div class="mt-3 font-mono text-[11px] tracking-[.14em] text-muted uppercase">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Fluid heading via clamp() */
  .about-heading {
    font-weight: 400;
    font-size: clamp(44px, 5.6vw, 84px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .about-heading :global(em) { font-style: italic; color: #a85c00;}
</style>
