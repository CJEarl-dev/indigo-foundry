---
type Props = {
  eyebrow?: string;
  /** Full title; pass <span class="mark-hl">word</span> to highlight part of it */
  titleHtml?: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  /** Show the hand-drawn "we reply within…" annotation */
  showAnnotation?: boolean;
};

const {
  eyebrow = 'Ready to start?',
  titleHtml = 'Let\u2019s build something <span class="mark-hl">worth</span> shipping.',
  description = "Tell us about your project and we'll get back within one business day.",
  primaryLabel = 'Start a project',
  primaryHref = '/contact',
  secondaryLabel = 'See all services',
  secondaryHref = '/services',
  showAnnotation = true,
} = Astro.props;
---

<section class="relative overflow-hidden py-[160px] text-center max-lg:py-[120px]">
  <!-- Bottom radial glow -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(55% 60% at 50% 100%, #D8F65122 0%, transparent 70%);"
  ></div>

<!--  {showAnnotation && (
    <div class="absolute top-[28%] right-[5%] z-[2] hidden rotate-[8deg] xl:block" aria-hidden="true">
      <div class="annotate static flex flex-col items-start gap-1"> 
        <span class="note note-lg">we reply within<br/>one business day</span>
        <svg width="140" height="30" viewBox="0 0 140 30" fill="none">
          <path d="M6 22 C 40 12, 80 10, 130 6" stroke="#141210" stroke-width="1.6" stroke-linecap="round" fill="none"/>
          <path d="M120 2 L132 6 L122 14" stroke="#141210" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </div>
    </div>
  )} -->

  <div class="relative mx-auto max-w-[1000px] px-8">
    <span class="pill-tag">{eyebrow}</span>
    <h2 class="cta-heading mt-6 font-serif" set:html={titleHtml} />
    <p class="mt-6 text-[18px] text-ink-2">{description}</p>
    <div class="mt-11 inline-flex flex-wrap justify-center gap-3">
      <a class="btn btn-primary" href={primaryHref}>
        {primaryLabel}
        <svg class="arrow" width="14" height="14" viewBox="0 0 14 14">
          <path d="M3 11 L11 3 M5 3 H11 V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </a>
      {secondaryLabel && secondaryHref && (
        <a class="btn btn-ghost" href={secondaryHref}>{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-heading {
    font-weight: 400;
    font-size: clamp(56px, 8vw, 120px);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .cta-heading :global(em) { font-style: italic; color: #a85c00;}
</style>
