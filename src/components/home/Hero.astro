---
// Home Hero — editorial image, floating stat cards, hand-drawn annotations.
// Layout via Tailwind; scoped CSS kept for fluid type (clamp) + hero-image gradients.
import { Image } from 'astro:assets';
import { site } from '../../data/site';
const { heroImage, heroImageAlt } = site;
---

<section class="relative isolate overflow-x-clip pt-12">
  <!-- Radial ambient glow -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background:
      background: #2D2A5E;"
  ></div>

  <!-- Grid overlay with soft elliptical mask -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background-image:
        linear-gradient(to right, #14121010 1px, transparent 1px),
        linear-gradient(to bottom, #14121010 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: radial-gradient(ellipse at 50% 30%, black 30%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at 50% 30%, black 30%, transparent 75%);"
  ></div>

  <!-- Annotation: points UP to the 'Get in touch' button in the nav (right side) -->
   <div class="w-full absolute ">
      <div class="mx-auto max-w-[1440px]">
        <div
          class="hidden ml-auto max-w-[260px] rotate-[4deg] xl:flex"
          aria-hidden="true"
        >
        <span class="note">yep, click<br/>right here</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="90" height="70" viewBox="0 0 90 70" fill="none" class="-translate-y-6">
          <path d="M9.81587 59.2215C9.3859 59.3232 9.11979 59.7542 9.22148 60.1841C9.32317 60.6141 9.75417 60.8802 10.1841 60.7785L10 60L9.81587 59.2215ZM82.5657 5.43431C82.2533 5.1219 81.7467 5.1219 81.4343 5.43431L76.3431 10.5255C76.0307 10.8379 76.0307 11.3444 76.3431 11.6569C76.6556 11.9693 77.1621 11.9693 77.4745 11.6569L82 7.13137L86.5255 11.6569C86.8379 11.9693 87.3444 11.9693 87.6569 11.6569C87.9693 11.3444 87.9693 10.8379 87.6569 10.5255L82.5657 5.43431ZM10 60L10.1841 60.7785C28.6462 56.412 46.7511 50.2611 60.2583 41.4638C73.7734 32.6613 82.8 21.1251 82.8 6L82 6L81.2 6C81.2 20.3749 72.6555 31.4799 59.3851 40.1231C46.1067 48.7714 28.2116 54.8706 9.81587 59.2215L10 60Z" fill="#141210"/>
        </svg>
      </div>  
    </div>
  </div>

  <div class="relative mx-auto max-w-[1280px] px-8 pt-10 text-center">
    <div class="pill-tag animate-fade-up inline-flex">Digital agency · est. 2018</div>
    <h1 class="hero-title animate-fade-up mx-auto mt-4 max-w-[1000px] font-serif" style="animation-delay:.05s">
      Websites that work as <span class="mark-hl">hard</span> as your team does.
    </h1>
    <p class="animate-fade-up mx-auto mt-6 max-w-[580px] text-[18px] leading-[1.5] text-ink-2" style="animation-delay:.12s">
      We design and build fast, accessible, SEO-friendly websites for ambitious
      teams that want to grow without wrestling with their tools.
    </p>
    <div class="animate-fade-up mt-7 inline-flex flex-wrap justify-center gap-3.5" style="animation-delay:.18s">
      <a class="btn btn-primary" href="/contact">
        Start a project
        <svg class="arrow" width="14" height="14" viewBox="0 0 14 14">
          <path d="M3 11 L11 3 M5 3 H11 V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </a>
      <a class="btn btn-ghost" href="/projects">See our work</a>
    </div>
    <div class="animate-fade-up mt-6 flex flex-wrap items-center justify-center gap-10 text-[13px] text-muted" style="animation-delay:.24s">
      <span class="inline-flex items-center gap-2">
        <span
          class="h-1.5 w-1.5 animate-[pulse-dot_2.5s_ease-in-out_infinite] rounded-full bg-[#25B34E]"
          style="box-shadow: 0 0 0 3px #25B34E22;"
        ></span>
        Booking 4–6 weeks out
      </span>
      <span>· Remote-first · SF + EU</span>
    </div>
  </div>

  <!-- Annotation: points DOWN to the hero image (left side) -->
   <div class="w-full absolute ">
    <div class="mx-auto max-w-[1200px]">
      <div
        class="hidden max-w-[220px] -rotate-6 xl:flex"
        aria-hidden="true"
      >
        <span class="note">real product<br/>shots — no stock</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="70" height="70" viewBox="0 0 70 70" fill="none">
          <path d="M18.4519 6.77063C18.0263 6.65203 17.7774 6.21085 17.8961 5.78524C18.0147 5.35963 18.4558 5.11076 18.8814 5.22937L18.6667 6L18.4519 6.77063ZM64.4436 60.4434C64.1987 60.8112 63.7021 60.9108 63.3344 60.6659L57.3417 56.6749C56.974 56.4299 56.8744 55.9333 57.1193 55.5656C57.3642 55.1978 57.8608 55.0982 58.2286 55.3432L63.5554 58.8907L67.1029 53.5639C67.3479 53.1962 67.8445 53.0966 68.2122 53.3415C68.58 53.5864 68.6796 54.083 68.4346 54.4508L64.4436 60.4434ZM18.6667 6L18.8814 5.22937C28.9488 8.03492 39.1016 15.4021 47.3548 25.1712C55.6139 34.9473 62.026 47.1929 64.5622 59.8427L63.7778 60L62.9934 60.1573C60.5173 47.8071 54.2419 35.8027 46.1325 26.2038C38.0173 16.5979 28.1206 9.46508 18.4519 6.77063L18.6667 6Z" fill="#141210"/>
        </svg>
      </div>
    </div>
  </div>

  <div 
    class="relative mx-auto mt-[120px] max-w-[1200px] px-8"
    style="-webkit-box-reflect: below 4px linear-gradient(transparent 84%, transparent 87%, rgba(0,0,0,0.45))"
  >
    <div class="hero-image relative aspect-[16/9] overflow-hidden rounded-[20px] border border-black/10"
    >
      {heroImage ? (
        <>
          <Image
            src={heroImage}
            alt={heroImageAlt}
            widths={[480, 640, 800, 1200, 1600]}
            sizes="(max-width: 768px) calc(100vw - 64px), (max-width: 1280px) calc(100vw - 64px), 1136px"
            format="webp"
            quality={65}
            class="absolute inset-0 h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <!-- Subtle dark overlay so the floating cards stay legible -->
          <div class="absolute inset-0 bg-[#141210]/20"></div>
        </>
      ) : (
        <>
          <div class="absolute top-8 right-8 font-serif text-[22px] italic text-[#FAF8F4] opacity-60">
            — a canvas for your next launch
          </div>
          <div class="absolute bottom-8 left-8 font-mono text-[11px] tracking-[.18em] text-[#FAF8F4] uppercase opacity-55">
            [ Replace with product shot · 1600×900 ]
          </div>
        </>
      )}
    </div>

    <!-- Floating stat cards -->
    <div
      class="absolute top-[20%] -left-5 -rotate-[4deg] hidden items-center gap-3.5 rounded-[14px] border border-line-strong bg-bg px-6 py-3.5 shadow-[0_20px_40px_-20px_#14121040] sm:flex"
      aria-hidden="true"
    >
      <div>
        <div class="text-[34px] leading-none">8+</div>
        <div class="mt-1 font-mono text-[10px] leading-[1.3] tracking-[.14em] text-muted uppercase">years of<br/>experience</div>
      </div>
    </div>
    <div
      class="absolute -right-2.5 bottom-[15%] hidden rotate-[3deg] items-center gap-3.5 rounded-[14px] border border-line-strong bg-bg px-6 py-3.5 shadow-[0_20px_40px_-20px_#14121040] sm:flex"
      aria-hidden="true"
    >
      <div>
        <div class="text-[34px] leading-none">100<span class="text-[20px]">%</span></div>
        <div class="mt-1 font-mono text-[10px] leading-[1.3] tracking-[.14em] text-muted uppercase">on-time<br/>delivery</div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Fluid clamp() for the hero headline — not expressible as a stable Tailwind class */
  .hero-title {
    font-size: clamp(48px, 7.5vw, 120px);
    line-height: 0.95;
    letter-spacing: -0.025em;
  }
  .hero-title :global(em) { font-style: italic; color: var(--color-ink-2); }

  /* Complex multi-layer gradient for the hero image placeholder */
  .hero-image {
    background:
      radial-gradient(80% 120% at 20% 10%, #D8F65128, transparent 60%),
      repeating-linear-gradient(135deg, #14121008 0 12px, transparent 12px 24px),
      linear-gradient(135deg, #1B1A17, #2B2721 50%, #1B1A17);
    /* box-shadow: 0 40px 80px -30px #14121040, 0 0 0 1px #14121008 inset; */
  }
  .hero-image::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(to right, #FAF8F408 1px, transparent 1px),
      linear-gradient(to bottom, #FAF8F408 1px, transparent 1px);
    background-size: 56px 56px;
  }
</style>
