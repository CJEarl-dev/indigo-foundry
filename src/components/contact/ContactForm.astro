  </div>

  <p class="text-[13px] leading-[1.5] text-muted">
    Prefer email? hello@indigo-foundry.com — we read everything.
  </p>
</form>

<style>
  /* Field labels */
  .contact-form label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Field controls — focus ring uses arbitrary box-shadow, easier in scoped CSS */
  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    padding: 14px 16px;
    background: var(--color-bg);
    border: 1px solid var(--color-line-strong);
    border-radius: 12px;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-ink);
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: var(--color-muted);
  }
  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: #4f46e5;
    box-shadow: 0 0 0 4px #4f46e540;
  }
  .contact-form textarea {
    resize: vertical;
    min-height: 140px;
  }

  /* Honeypot field — hidden from sighted users, but NOT display:none/visibility:hidden.
     Netlify (and most bots scanning the DOM) can tell those two apart from genuinely
     visually-hidden-but-present fields, so we use an off-screen position instead. */
  .hidden-field {
    position: absolute;
    left: -5000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Hand-drawn annotation positioning */
  .annotate-submit {
    position: absolute;
    left: 170px;
    top: -20px;
    transform: rotate(-6deg);
  }
</style>