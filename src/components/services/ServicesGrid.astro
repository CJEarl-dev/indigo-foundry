---
// Services grid — 2-up editorial cards, big numeral + green list icons.
// No hover transform per feedback, just a subtle border change.
import { services } from '../../data/services';
---

<section class="py-[120px] pt-0 max-md:py-20 max-md:pt-0">
  <div class="wrap">
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
      {services.map((service, i) => (
        <article
          id={service.slug}
          class="grid grid-cols-1 gap-8 rounded-[22px] border border-line bg-card p-10 transition-colors duration-[250ms] hover:border-line-strong lg:grid-cols-[auto_1fr] max-lg:gap-5 max-lg:p-7"
        >
          <div class="font-serif text-[48px] leading-none tracking-[-0.02em] text-ink ">
            <span class="mark-hl px-4">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div>
            <h3 class="text-[34px] font-normal tracking-[-0.01em]">{service.title}</h3>
            <p class="mt-3 text-[15px] leading-[1.55] text-ink-2">{service.description}</p>
            <ul class="mt-6 grid grid-cols-1 gap-x-5 gap-y-2.5 text-[14px] text-ink-2 md:grid-cols-2">
              {service.features.map((feature) => (
                <li class="flex items-center gap-2.5 py-0.5">
                  <svg
                    class="box-content shrink-0 rounded-full bg-accent p-[3px] text-accent-ink"
                    width="10" height="10" viewBox="0 0 14 14"
                    aria-hidden="true"
                  >
                    <path d="M3 7.5 L6 10.5 L11.5 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <a
              href={`/contact?service=${service.slug}`}
              class="svc-link mt-7 inline-flex items-center gap-1.5 border-b border-ink pb-0.5 text-sm font-medium transition-[gap] duration-200 hover:gap-2.5"
            >
              Talk about this
              <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true">
                <path d="M3 11 L11 3 M5 3 H11 V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Lime-outlined numeral can't be done cleanly with arbitrary Tailwind
     because of -webkit-text-stroke. Keep it here. */
  .svc-num-em {
    /* background-color: #D8F651; */
  }
</style>
