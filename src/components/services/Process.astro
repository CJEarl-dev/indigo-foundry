---
// Process — dark section with 4 numbered steps, lime dot connectors
import { processSteps } from '../../data/services';
---

<section class="relative overflow-hidden bg-ink py-[140px] text-[#F5F1E7] max-md:py-[100px]">
  <!-- Dot-grid pattern overlay -->
  <div
    class="pointer-events-none absolute inset-0 opacity-40"
    style="background-image: radial-gradient(#FAF8F410 1px, transparent 1px); background-size: 28px 28px;"
  ></div>

  <div class="wrap relative">
    <span class="eyebrow !text-ink-soft">How we work</span>
    <h2 class="process-head mt-4 max-w-[900px] font-serif text-[#F5F1E7]">
      A predictable process, <em>from first call to launch.</em>
    </h2>

    <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      {processSteps.map((step, i) => (
        <div
          class:list={[
            'relative py-8 px-6 lg:border-r lg:border-white/10 lg:last:border-r-0 lg:first:pl-0 max-lg:px-0',
          ]}
        >
          <div class="mb-10 font-mono text-xs tracking-[.16em] text-[#3D3580] uppercase">
            {step.number} / {step.title}
          </div>

          {i < processSteps.length - 1 && (
            <span
              class="absolute -right-1.5 top-8 hidden h-3 w-3 rounded-full bg-[#1A1830] lg:block"
              style="box-shadow: 0 0 0 4px #1A183022;"
              aria-hidden="true"
            ></span>
          )}

          <h4 class="text-[28px] font-normal tracking-[-0.01em]">{step.title}</h4>
          <p class="mt-3 text-sm leading-[1.55] text-[#C9C4BA]">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-head {
    font-weight: 400;
    font-size: clamp(44px, 5.6vw, 84px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .process-head :global(em) { font-style: italic; color: #a85c00; }
</style>