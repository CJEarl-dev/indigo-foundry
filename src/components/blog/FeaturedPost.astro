---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { title, description, pubDate, category, image, imageAlt } = post.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<section class="pt-10 pb-20">
  <div class="wrap">
    <span class="eyebrow">Featured</span>
    <a
      href={`/blog/${post.id}`}
      class="group mt-5 grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-[60px]"
    >
      <div class="aspect-[16/11] overflow-hidden rounded-[20px] bg-bg-2">
        <Image
          src={image}
          alt={imageAlt}
          widths={[600, 1200]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="h-full w-full object-cover transition-transform duration-[400ms] ease-out group-hover:scale-[1.02]"
        />
      </div>
      <div>
        <div class="flex items-center gap-2.5 font-mono text-[11px] tracking-[.16em] text-muted uppercase">
          <span class="text-ink">{category}</span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        </div>
        <h2 class="featured-title mt-3.5 font-serif text-ink">{title}</h2>
        <p class="mt-5 text-[18px] leading-[1.55] text-ink-2">{description}</p>
        <span class="mt-6 inline-block border-b border-ink pb-0.5 text-sm font-medium text-ink">
          Read article →
        </span>
      </div>
    </a>
  </div>
</section>

<style>
  /* Fluid title — clamp() doesn't fit Tailwind cleanly */
  .featured-title {
    font-weight: 400;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
</style>
