---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { title, description, pubDate, category, image, imageAlt } = post.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group">
  <a href={`/blog/${post.id}`} class="block">
    <div class="mb-5 aspect-[16/10] overflow-hidden rounded-2xl bg-bg-2">
      <Image
        src={image}
        alt={imageAlt}
        widths={[400, 800]}
        sizes="(max-width: 768px) 100vw, 33vw"
        class="h-full w-full object-cover transition-transform duration-[400ms] ease-out group-hover:scale-[1.03]"
      />
    </div>
    <div class="flex items-center gap-2.5 font-mono text-[11px] tracking-[.14em] text-muted uppercase">
      <span class="text-ink">{category}</span>
      <span aria-hidden="true">·</span>
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>
    <h3 class="mt-2.5 font-serif text-[22px] font-normal leading-tight tracking-[-0.01em] text-ink">
      {title}
    </h3>
    <p class="mt-2.5 text-sm leading-[1.55] text-ink-2">{description}</p>
    <span class="mt-3.5 inline-block border-b border-transparent pb-0.5 text-[13px] font-medium text-ink transition-colors duration-150 group-hover:border-ink">
      Read article →
    </span>
  </a>
</article>
