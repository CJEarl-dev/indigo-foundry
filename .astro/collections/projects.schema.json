{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Web",
        "Branding",
        "SEO",
        "UI/UX",
        "E-commerce"
      ]
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "gallery": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "results": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "metric",
          "value"
        ]
      }
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "default": 0,
      "type": "number"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "client",
    "category",
    "date",
    "description",
    "image"
  ]
}